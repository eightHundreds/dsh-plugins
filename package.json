{
  "name": "@dsk/plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run build && pnpm -r --if-present run test && node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run test && node scripts/check/verify-packages.mjs && node scripts/check/check-workflows.mjs",
    "verify:desktop": "node scripts/check/verify-desktop-install.mjs",
    "new:plugin": "node scripts/scaffold/new-plugin.mjs",
    "pack:all": "pnpm run check && pnpm -r pack --pack-destination ./artifacts && node scripts/release/verify-tarballs.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:pack": "pnpm pack:all && node scripts/release/pack-release.mjs",
    "test:release": "node scripts/release/test-release-install.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@deepseek-ai/cordis": "4.0.4",
    "husky": "^9.1.7",
    "js-yaml": "4.2.0",
    "typescript": "5.9.3"
  }
}
