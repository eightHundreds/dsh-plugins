{
  "name": "@dshx/bash-rtk",
  "description": "RTK-aware sandbox bash executor using the official DeepSeek Harness public SDK, without core modifications.",
  "version": "0.2.0",
  "icon": "./icon.png",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wrap": {
      "types": "./lib/wrap.d.ts",
      "default": "./lib/wrap.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon.png": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "dsh.plugin.json",
    "icon.png",
    "LICENSE",
    "UPSTREAM.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-bash-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "rtk",
    "token-compression",
    "bash",
    "shell",
    "cordis",
    "plugin"
  ],
  "homepage": "https://github.com/DeepTrial/dsh-bash-rtk#readme",
  "author": "DeepTrial",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
